#!/usr/bin/env bash
# srt-shift: shift every timestamp in an SRT file by a number of seconds.
#
# Usage:
#   srt-shift <delta-seconds> [input.srt] [> output.srt]
#
# Examples:
#   srt-shift 2 movie.srt > movie.shifted.srt
#   srt-shift -1.5 movie.srt > movie.early.srt
#   cat movie.srt | srt-shift 2 > movie.shifted.srt
#
# Negative shifts move subtitles earlier; cues that would end up with
# negative start times are dropped (a warning is printed to stderr).

set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "srt-shift: usage: srt-shift <delta-seconds> [input.srt]" >&2
  exit 1
fi

DELTA="$1"
INPUT_FILE="${2:-/dev/stdin}"

awk -v delta="$DELTA" '
  function parse_time(s,    h, m, sec, ms, parts) {
    # SRT timestamps: HH:MM:SS,mmm
    split(s, parts, /[:,]/)
    h = parts[1]
    m = parts[2]
    sec = parts[3]
    ms = parts[4]
    return (h * 3600 + m * 60 + sec) * 1000 + ms
  }
  function format_time(ms,    h, m, s, millis) {
    millis = ms % 1000
    s = int(ms / 1000) % 60
    m = int(ms / 60000) % 60
    h = int(ms / 3600000)
    return sprintf("%02d:%02d:%02d,%03d", h, m, s, millis)
  }
  /^[0-9]{1,2}:[0-9]{2}:[0-9]{2}[,\.][0-9]{1,3}[[:space:]]*-->[[:space:]]*[0-9]{1,2}:[0-9]{2}:[0-9]{2}[,\.][0-9]{1,3}/ {
    # Extract the two timestamps.
    match($0, /^[0-9:,\.]+/)
    start_str = substr($0, RSTART, RLENGTH)
    rest = substr($0, RSTART + RLENGTH)
    # Skip past arrow.
    sub(/^[[:space:]]*-->[[:space:]]*/, "", rest)
    match(rest, /^[0-9:,\.]+/)
    end_str = substr(rest, RSTART, RLENGTH)
    # Normalize . to , (some SRT files use either)
    gsub(/\./, ",", start_str)
    gsub(/\./, ",", end_str)
    start_ms = parse_time(start_str)
    end_ms = parse_time(end_str)
    new_start = start_ms + delta * 1000
    new_end = end_ms + delta * 1000
    if (new_start < 0) {
      printf("srt-shift: dropping cue starting at %s (negative shift result)\n", start_str) > "/dev/stderr"
      skip = 1
      next
    }
    skip = 0
    print format_time(new_start) " --> " format_time(new_end)
    next
  }
  {
    if (!skip) print
  }
' "$INPUT_FILE"
